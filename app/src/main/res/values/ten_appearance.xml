    <style name="TenLightControls">
        <item name="android:colorBackground">#FAFAFA</item>
        <item name="android:colorForeground">#18232C</item>
        <item name="android:textColorPrimary">#18232C</item>
        <item name="android:textColorSecondary">#666666</item>
