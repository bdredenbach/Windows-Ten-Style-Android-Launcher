        <item name="android:colorControlHighlight">#330078D7</item>
        <item name="android:popupMenuStyle">@style/AeroPopupMenu</item>
    </style>
    <style name="TenDarkPopupMenu" parent="android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">#292929</item>
    </style>
    <item type="id" name="ten_appearance_accent"/>
