<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="${launcherApplicationId}" /></queries>
    <application android:label="Nth isolated test files" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
        <provider android:name=".FixtureProvider" android:authorities="com.nthexperience.desktop.fixture.documents" android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <activity android:name=".TaskActivity" android:exported="true" android:launchMode="singleTask" android:label="Task switch probe"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
        <activity-alias android:name=".AudibleProbe" android:targetActivity=".TaskActivity" android:exported="true" android:label="Audible"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".NotaChoiceOne" android:targetActivity=".TaskActivity" android:exported="true" android:label="Nota duplicate"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".NotaChoiceTwo" android:targetActivity=".TaskActivity" android:exported="true" android:label="Nota duplicate"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity android:name=".GrantActivity" android:exported="true" />
    </application>
</manifest>
